#!/bin/sh
# Blocks commits that contain secrets. Activated automatically by `npm install` (see "prepare").
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (macOS: brew install gitleaks). Commit aborted." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
