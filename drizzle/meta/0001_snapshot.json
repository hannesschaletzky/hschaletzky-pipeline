        "applications_closed_at_matches_status": {
          "name": "applications_closed_at_matches_status",
          "value": "(\"applications\".\"status\" in ('won', 'rejected', 'withdrawn', 'skipped')) = (\"applications\".\"closed_at\" is not null)"
        },
        "applications_remote_share_range": {
          "name": "applications_remote_share_range",
          "value": "\"applications\".\"remote_share\" is null or \"applications\".\"remote_share\" between 0 and 100"
        },
        "applications_not_same_project_as_itself": {
          "name": "applications_not_same_project_as_itself",
          "value": "\"applications\".\"same_project_as_id\" <> \"applications\".\"id\""
        },
        "applications_rate_eur_positive": {
          "name": "applications_rate_eur_positive",
          "value": "\"applications\".\"rate_eur\" is null or \"applications\".\"rate_eur\" > 0"
        },
        "applications_date_order": {
          "name": "applications_date_order",
          "value": "\"applications\".\"start_date\" is null or \"applications\".\"end_date\" is null or \"applications\".\"end_date\" >= \"applications\".\"start_date\""
        }
