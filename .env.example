# Copy to .env for local development. Placeholder values only — never commit real secrets.
# In production, secrets are passed as files instead: DATABASE_PASSWORD_FILE=/run/secrets/...
# (supported for DATABASE_PASSWORD, MIGRATION_DATABASE_PASSWORD and APP_DB_PASSWORD).

# Owner role: used by docker compose and the migration step
POSTGRES_PASSWORD=change-me-owner
MIGRATION_DATABASE_URL=postgres://pipeline:change-me-owner@localhost:5432/pipeline

# Least-privilege role the app connects with; created and updated by `npm run db:migrate`
APP_DB_PASSWORD=change-me-app-local-only
DATABASE_URL=postgres://pipeline_app:change-me-app-local-only@localhost:5432/pipeline

PORT=3000
