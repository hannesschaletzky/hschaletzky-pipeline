# Copy to .env for local development. Placeholder values only — never commit real secrets.
# In production, secrets are passed as files instead: DATABASE_PASSWORD_FILE=/run/secrets/...
# (supported for all passwords and the GitHub client id/secret).

# Owner role: used by docker compose and the migration step
POSTGRES_PASSWORD=change-me-owner
MIGRATION_DATABASE_URL=postgres://pipeline:change-me-owner@localhost:5432/pipeline

# Least-privilege role the app connects with; created and updated by `npm run db:migrate`
APP_DB_PASSWORD=change-me-app-local-only
DATABASE_URL=postgres://pipeline_app:change-me-app-local-only@localhost:5432/pipeline

PORT=3000

# OAuth for /mcp via GitHub login (all or none; without them /mcp is disabled).
# GitHub OAuth App callback: <PUBLIC_BASE_URL>/oauth/github/callback
# Numeric user id: curl https://api.github.com/users/<login>
# PUBLIC_BASE_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USER_ID=

# Optional: delete contacts once all their applications have been closed for this many days.
# Unset: only contacts with an explicit delete_after date are deleted.
# CONTACT_RETENTION_DAYS=365

# Optional: read-only role for backups (pg_dump), managed by `npm run db:migrate`.
# BACKUP_DB_PASSWORD=change-me-backup-local-only

# Optional: file with the time of the last successful backup (ISO 8601); /health then reports its age.
# BACKUP_STATUS_FILE=/backup-status/last-success
