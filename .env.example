# Copy to .env for local development. Placeholder values only — never commit real secrets.

# Owner role (used by docker compose and migrations)
POSTGRES_PASSWORD=change-me-owner
# Least-privilege role used by the running app (created by docker/postgres/init)
APP_DB_PASSWORD=change-me-app

MIGRATION_DATABASE_URL=postgres://pipeline:change-me-owner@localhost:5432/pipeline
DATABASE_URL=postgres://pipeline_app:change-me-app@localhost:5432/pipeline
PORT=3000
